# Copy to .env (gitignored); mise loads it for every task.

# The assistant: any OpenAI-compatible endpoint. OpenRouter by default.
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# LLM_REASONING_TOKENS=0
# LLM_DAILY_TOKENS=10000000

# The synthetic feed (see `{{cookiecutter.project_slug}} generate --help`).
# GENERATE_SINCE=2019-01-01
# GENERATE_DAILY=25
# GENERATE_SEED=1

LOG_LEVEL=INFO
