# Copy to .env.prod (gitignored); kustomize turns it into the {{cookiecutter.project_slug}}-envs secret.
OPENROUTER_API_KEY=          # or LLM_API_KEY (+ LLM_BASE_URL for another provider)
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_REASONING_TOKENS=0
LLM_DAILY_TOKENS=10000000
LOG_LEVEL=INFO

# Optional: replicate the app database (feedback, LLM usage) to S3/R2 with
# litestream. Without these the pod keeps it on its emptyDir and loses it on
# restart.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Admin basic auth lives in a separate .env.admin (ADMIN_USER, ADMIN_PASSWORD)
# so the password never enters the app's environment; `mise run admin-htpasswd`
# turns it into .admin-htpasswd for Traefik.
