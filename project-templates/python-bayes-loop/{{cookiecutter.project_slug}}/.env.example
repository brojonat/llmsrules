# Copy to .env (gitignored; mise loads it). Restart `mise run dev` after editing.

# Lets the dashboard ask an LLM for a plain-English description of each model.
OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint works instead:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=anthropic/claude-haiku-4.5

# A real token for the Quack db (mise.toml sets a dev default).
# QUACK_TOKEN=

# A second checkout on this machine needs its own ports.
# PORT=8771
# QUACK_URL=quack:localhost:9511

# Replay a prepared file through the belt (see .agents/skills/new-model).
# FEED_FROM=data/<name>.parquet
# FEED_ORDER_BY=<column>
