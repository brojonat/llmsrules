# Copy to .env (gitignored; mise loads it). Restart `mise run dev` after editing.

# A real token for the Quack db (mise.toml sets a dev default).
# QUACK_TOKEN=

# A second checkout on this machine needs its own ports.
# PORT=8771
# QUACK_URL=quack:localhost:9511

# Your prepared data file, which `mise run feed` reads (see .agents/skills/new-model).
# FEED_FROM=data/<name>.parquet
# FEED_ORDER_BY=<column>
