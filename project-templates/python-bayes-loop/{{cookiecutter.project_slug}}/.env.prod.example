# Copy to .env.prod (gitignored). `mise run deploy` turns it into a Secret.

# The belt's token. Every container in the pod shares it; nothing outside the
# pod can reach the belt (it listens on localhost only).
QUACK_TOKEN=

# The dashboard's model description (any OpenAI-compatible endpoint).
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
