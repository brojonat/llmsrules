# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
SERVICE_NAME={{cookiecutter.project_slug}}

# MLflow configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# For remote MLflow server:
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: S3 artifact storage (local Garage from docker-compose.yaml).
# Point MLflow at it with --default-artifact-root s3://mlflow-artifacts/
# AWS_ACCESS_KEY_ID=GKdevaccesskey
# AWS_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
# AWS_DEFAULT_REGION=us-east-1
# MLFLOW_S3_ENDPOINT_URL=http://localhost:3900
