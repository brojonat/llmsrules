package monitor

import (
	"{{cookiecutter.go_mod}}/features/common/components"
	"{{cookiecutter.go_mod}}/features/common/layouts"
)

templ Page(title string) {
	@layouts.Base(title) {
		<main class="flex flex-col w-full min-h-screen" data-init="@get('/monitor/events', {openWhenHidden: true})">
			@components.Nav(components.PageMonitor)
			<div class="card bg-base-200 shadow-xl mx-auto my-4 w-full max-w-2xl">
				<div class="card-body gap-4">
					<h1 class="card-title text-3xl font-bold">System monitor</h1>
					<p class="text-sm opacity-70">
						Pure server push. Nothing on this page is clickable -- the
						server resamples host stats twice a second, renders them
						once for every viewer, and Datastar morphs the frame in.
					</p>
					@StatsView(Stats{})
				</div>
			</div>
		</main>
	}
}

// StatsView is the frame pushed over SSE. Its id must match the placeholder
// rendered by Page, since Datastar patches elements by id.
templ StatsView(s Stats) {
	<div id="monitor-stats" class="flex flex-col gap-4">
		<div class="stats stats-vertical sm:stats-horizontal shadow">
			@stat("Memory used", s.MemUsed)
			@stat("Memory total", s.MemTotal)
			@stat("Memory %", s.MemPercent)
		</div>
		<div class="stats stats-vertical sm:stats-horizontal shadow">
			@stat("CPU user", s.CPUUser)
			@stat("CPU system", s.CPUSystem)
			@stat("CPU idle", s.CPUIdle)
		</div>
	</div>
}

templ stat(title, value string) {
	<div class="stat">
		<div class="stat-title">{ title }</div>
		<div class="stat-value text-2xl font-mono">
			if value == "" {
				&mdash;
			} else {
				{ value }
			}
		</div>
	</div>
}
