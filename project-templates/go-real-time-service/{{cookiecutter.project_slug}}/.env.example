export SERVER_ADDR=":8080"
export LOG_LEVEL="debug"
export AUTH_SECRET="change-me-in-production"
export SESSION_SECRET="change-me-in-production"
# NATS runs embedded in-process. Leave unset to pick a free port automatically.
export NATS_PORT="4222"
# How often live views re-render (and the fastest any stream updates).
export FRAME_TICK="100ms"
export DOCKER_REGISTRY="{{cookiecutter.docker_registry}}"
